# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Local agent tooling state
.serena/
.superpowers/

# Python. The skill needs no venv, but an old install may have left one in
# skills/imager/, and a contributor may make one for pytest.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Generated images. The skill writes wherever it is pointed, and the working
# directory is the obvious place to point it while trying something out.
*.png
*.jpg
*.jpeg
*.webp
!assets/*.png
